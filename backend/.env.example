# Copy to backend/.env for local runs (git-ignored; never commit it).
# On Vercel, set these in Project Settings > Environment Variables instead.
# Every variable is read in one place: config/config.go.

# PostgreSQL connection string. Required.
# Local (Docker, see README):  postgres://approval:approval@localhost:5433/approval_engine?sslmode=disable
# Vercel: set automatically by the Neon integration.
DATABASE_URL=postgres://approval:approval@localhost:5433/approval_engine?sslmode=disable

# Signs login tokens. Required, at least 32 characters, secret.
# Generate one with:  openssl rand -hex 32
# Use a different value in every environment; changing it logs everyone out.
JWT_SECRET=replace-with-the-output-of-openssl-rand-hex-32

# Passwords for the two built-in accounts, created on first start if missing:
#   admin@company.com (ADMIN) and manager@company.com (MANAGER).
# Sign-up only ever creates employees, so without these there is no approver.
# At least 8 characters each. Optional; existing accounts are never changed.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=

# Password for a built-in employee@company.com (STANDARD grade, reports to
# the manager), created on first start if missing. Optional.
SEED_EMPLOYEE_PASSWORD=

# Public demo only (the live site uses it): true lists the seed accounts and
# their passwords on the login page (GET /api/demo-logins) and restores the
# default rules on every cron run. The seed passwords are then public, so
# never turn it on for real data. Default false.
DEMO_MODE=false

# Login cookie is HTTPS-only. Set false only for local http://localhost runs.
COOKIE_SECURE=false

# Browser origins allowed to call the API from another domain, comma-separated.
# Empty (the default) means same-origin only, which is how Vercel serves it and
# how the Vite dev server proxies /api. Never "*".
CORS_ORIGINS=

# release (default) or debug.
GIN_MODE=debug

# Port for `go run ./cmd/server` (Render-style hosts set PORT themselves).
PORT=8080

# Secret for GET /api/cron/auto-reject (Vercel Cron sends it as a Bearer
# token). Empty disables the endpoint. Generate with: openssl rand -hex 32
CRON_SECRET=

# Run the nightly auto-reject job inside the server process (true by default;
# the Vercel function ignores it and relies on Vercel Cron).
RUN_CRON=true
