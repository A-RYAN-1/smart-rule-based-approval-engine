# Copy to frontend/.env.local if you need to change it (git-ignored).

# Base URL of the API. Leave empty: the app then calls /api on its own origin,
# which the Vite dev server proxies to http://localhost:8080 and Vercel routes
# to the Go function. Set it only if the API lives on another domain (then add
# this site's origin to the backend's CORS_ORIGINS).
VITE_API_URL=
